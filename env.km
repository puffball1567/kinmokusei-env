import go fmt from "fmt";
import go os from "os";
import go sort from "sort";
import go strconv from "strconv";
import go strings from "strings";

export class Environment {
  private values: Map<bstring, bstring>;

  constructor() {
    this.values = makeMap[bstring, bstring]();
  }

  public function has(name: bstring): boolean {
    const [_, found] = this.values[name];
    return found;
  }

  public function size(): int {
    return len(this.values);
  }

  public function names(): bstring[] {
    let names: bstring[] = [];
    for (const [name, _] of this.values) {
      names = append(names, name);
    }
    sort.Strings(names);
    return names;
  }

  public function text(name: bstring): Result<bstring> {
    const [value, found] = this.values[name];
    if (!found) {
      return fail(fmt.Errorf("environment variable %s is not defined", name));
    }
    return ok(value);
  }

  public function textOr(name: bstring, defaultValue: bstring): bstring {
    const [value, found] = this.values[name];
    if (!found) {
      return defaultValue;
    }
    return value;
  }

  public function integer(name: bstring): Result<int> {
    const value = this.text(name)?;
    const [parsed, parseError] = strconv.Atoi(value);
    if (parseError !== nil) {
      return fail(fmt.Errorf("environment variable %s has invalid integer value %q", name, value));
    }
    return ok(parsed);
  }

  public function integerOr(name: bstring, defaultValue: int): Result<int> {
    if (!this.has(name)) {
      return ok(defaultValue);
    }
    return this.integer(name);
  }

  public function boolean(name: bstring): Result<boolean> {
    const value = this.text(name)?;
    const [parsed, parseError] = strconv.ParseBool(value);
    if (parseError !== nil) {
      return fail(fmt.Errorf("environment variable %s has invalid boolean value %q", name, value));
    }
    return ok(parsed);
  }

  public function booleanOr(name: bstring, defaultValue: boolean): Result<boolean> {
    if (!this.has(name)) {
      return ok(defaultValue);
    }
    return this.boolean(name);
  }

  public function number(name: bstring): Result<float64> {
    const value = this.text(name)?;
    const [parsed, parseError] = strconv.ParseFloat(value, 64);
    if (parseError !== nil) {
      return fail(fmt.Errorf("environment variable %s has invalid number value %q", name, value));
    }
    return ok(parsed);
  }

  public function numberOr(name: bstring, defaultValue: float64): Result<float64> {
    if (!this.has(name)) {
      return ok(defaultValue);
    }
    return this.number(name);
  }

  public function nonEmpty(name: bstring): Result<bstring> {
    const value = this.text(name)?;
    if (value == "") {
      return fail(fmt.Errorf("environment variable %s must not be empty", name));
    }
    return ok(value);
  }

  public function choice(name: bstring, allowed: bstring[]): Result<bstring> {
    if (len(allowed) == 0) {
      return fail(fmt.Errorf("allowed values for environment variable %s must not be empty", name));
    }
    const value = this.text(name)?;
    for (const candidate of allowed) {
      if (candidate == value) {
        return ok(value);
      }
    }
    return fail(fmt.Errorf("environment variable %s has invalid value %q: expected one of %s", name, value, strings.Join(allowed, ", ")));
  }

  public function integerRange(name: bstring, minimum: int, maximum: int): Result<int> {
    if (maximum < minimum) {
      return fail(fmt.Errorf("invalid integer range %d..%d for environment variable %s", minimum, maximum, name));
    }
    const value = this.integer(name)?;
    if (value < minimum || value > maximum) {
      return fail(fmt.Errorf("environment variable %s has value %d outside %d..%d", name, value, minimum, maximum));
    }
    return ok(value);
  }

  public function require(names: bstring[]): Result<void> {
    for (const name of names) {
      if (!this.has(name)) {
        return fail(fmt.Errorf("environment variable %s is not defined", name));
      }
    }
    return ok();
  }

  public function set(name: bstring, value: bstring): Result<void> {
    if (!validName(name)) {
      return fail(fmt.Errorf("invalid environment variable name %q", name));
    }
    this.values[name] = value;
    return ok();
  }

  public function remove(name: bstring): boolean {
    const [_, found] = this.values[name];
    if (found) {
      delete(this.values, name);
    }
    return found;
  }

  public function clone(): Environment {
    const cloned = new Environment();
    for (const [name, value] of this.values) {
      const _ = cloned.set(name, value);
    }
    return cloned;
  }

  public function merge(other: Environment, overwrite: boolean): void {
    for (const [name, value] of other.values) {
      if (overwrite || !this.has(name)) {
        this.values[name] = value;
      }
    }
  }

  public function encode(): bstring {
    let output: bstring = "";
    for (const name of this.names()) {
      const [value, _] = this.values[name];
      output += name + "=\"" + escapeValue(value) + "\"\n";
    }
    return output;
  }

  public function expanded(): Result<Environment> {
    const result = new Environment();
    const states = makeMap[bstring, int]();
    for (const name of this.names()) {
      const _ = this.resolve(name, states, result)?;
    }
    return ok(result);
  }

  public function apply(overwrite: boolean): Result<void> {
    for (const [name, value] of this.values) {
      const [_, exists] = os.LookupEnv(name);
      if (overwrite || !exists) {
        os.Setenv(name, value)?;
      }
    }
    return ok();
  }

  private function resolve(name: bstring, states: Map<bstring, int>, result: Environment): Result<bstring> {
    const [state, stateFound] = states[name];
    if (stateFound && state == 1) {
      return fail(fmt.Errorf("cyclic environment variable expansion involving %s", name));
    }
    if (stateFound && state == 2) {
      return result.text(name);
    }

    const source = this.text(name)?;
    states[name] = 1;
    let output: bstring = "";
    let index = 0;
    while (index < len(source)) {
      if (source[index:index + 1] == "$" && index + 1 < len(source) && source[index + 1:index + 2] == "{") {
        const closing = strings.Index(source[index + 2:], "}");
        if (closing < 0) {
          return fail(fmt.Errorf("environment variable %s has unterminated expansion", name));
        }
        const end = index + 2 + closing;
        const referencedName = source[index + 2:end];
        if (!validName(referencedName)) {
          return fail(fmt.Errorf("environment variable %s has invalid expansion name %q", name, referencedName));
        }
        if (!this.has(referencedName)) {
          return fail(fmt.Errorf("environment variable %s references undefined variable %s", name, referencedName));
        }
        const referencedValue = this.resolve(referencedName, states, result)?;
        output += referencedValue;
        index = end + 1;
      } else {
        output += source[index:index + 1];
        index++;
      }
    }
    states[name] = 2;
    const _ = result.set(name, output);
    return ok(output);
  }
}

export function parse(text: bstring): Result<Environment> {
  return parseInternal(text, false);
}

export function parseStrict(text: bstring): Result<Environment> {
  return parseInternal(text, true);
}

function parseInternal(text: bstring, rejectDuplicates: boolean): Result<Environment> {
  const environment = new Environment();
  const lines = strings.Split(strings.TrimPrefix(text, "\uFEFF"), "\n");

  for (let index = 0; index < len(lines); index++) {
    const lineNumber = index + 1;
    let line = strings.TrimSuffix(lines[index], "\r");
    line = strings.TrimSpace(line);
    if (line == "" || strings.HasPrefix(line, "#")) {
      continue;
    }
    if (strings.HasPrefix(line, "export ") || strings.HasPrefix(line, "export\t")) {
      line = strings.TrimSpace(line[6:]);
    }

    const separator = strings.Index(line, "=");
    if (separator < 0) {
      return fail(fmt.Errorf("line %d: expected NAME=VALUE", lineNumber));
    }
    const name = strings.TrimSpace(line[:separator]);
    if (rejectDuplicates && environment.has(name)) {
      return fail(fmt.Errorf("line %d: duplicate environment variable %s", lineNumber, name));
    }
    const value = parseValue(line[separator + 1:], lineNumber)?;
    const [setError] = environment.set(name, value);
    if (setError !== nil) {
      return fail(fmt.Errorf("line %d: %s", lineNumber, setError.Error()));
    }
  }
  return ok(environment);
}

export function load(path: bstring): Result<Environment> {
  const contents = os.ReadFile(path)?;
  return parse(bstring(contents));
}

export function loadStrict(path: bstring): Result<Environment> {
  const contents = os.ReadFile(path)?;
  return parseStrict(bstring(contents));
}

export function loadIfExists(path: bstring): Result<Environment> {
  const [contents, readError] = os.ReadFile(path);
  if (readError !== nil) {
    if (os.IsNotExist(readError)) {
      return ok(new Environment());
    }
    return fail(readError);
  }
  return parse(bstring(contents));
}

export function fromProcess(names: bstring[]): Result<Environment> {
  const environment = new Environment();
  for (const name of names) {
    if (!validName(name)) {
      return fail(fmt.Errorf("invalid environment variable name %q", name));
    }
    const [value, found] = os.LookupEnv(name);
    if (found) {
      const _ = environment.set(name, value);
    }
  }
  return ok(environment);
}

export function fromProcessAll(): Environment {
  const environment = new Environment();
  for (const assignment of os.Environ()) {
    const separator = strings.Index(assignment, "=");
    if (separator > 0) {
      const name = assignment[:separator];
      if (validName(name)) {
        const _ = environment.set(name, assignment[separator + 1:]);
      }
    }
  }
  return environment;
}

function validName(name: bstring): boolean {
  if (len(name) == 0) {
    return false;
  }
  for (let index = 0; index < len(name); index++) {
    const character = name[index:index + 1];
    const letter = (character >= "a" && character <= "z") || (character >= "A" && character <= "Z");
    const digit = character >= "0" && character <= "9";
    if (index == 0) {
      if (!letter && character != "_") {
        return false;
      }
    } else if (!letter && !digit && character != "_") {
      return false;
    }
  }
  return true;
}

function escapeValue(value: bstring): bstring {
  let escaped = strings.ReplaceAll(value, "\\", "\\\\");
  escaped = strings.ReplaceAll(escaped, "\"", "\\\"");
  escaped = strings.ReplaceAll(escaped, "\n", "\\n");
  escaped = strings.ReplaceAll(escaped, "\r", "\\r");
  escaped = strings.ReplaceAll(escaped, "\t", "\\t");
  return escaped;
}

function parseValue(source: bstring, lineNumber: int): Result<bstring> {
  const value = strings.TrimSpace(source);
  if (value == "") {
    return ok("");
  }
  if (strings.HasPrefix(value, "'")) {
    return parseSingleQuoted(value, lineNumber);
  }
  if (strings.HasPrefix(value, "\"")) {
    return parseDoubleQuoted(value, lineNumber);
  }

  for (let index = 0; index < len(value); index++) {
    if (value[index:index + 1] == "#" && index > 0) {
      const previous = value[index - 1:index];
      if (previous == " " || previous == "\t") {
        return ok(strings.TrimSpace(value[:index]));
      }
    }
  }
  return ok(value);
}

function parseSingleQuoted(value: bstring, lineNumber: int): Result<bstring> {
  const closing = strings.Index(value[1:], "'");
  if (closing < 0) {
    return fail(fmt.Errorf("line %d: unterminated single-quoted value", lineNumber));
  }
  const end = closing + 1;
  validateTrailing(value[end + 1:], lineNumber)?;
  return ok(value[1:end]);
}

function parseDoubleQuoted(value: bstring, lineNumber: int): Result<bstring> {
  let output: bstring = "";
  let escaped = false;
  for (let index = 1; index < len(value); index++) {
    const character = value[index:index + 1];
    if (escaped) {
      if (character == "n") {
        output += "\n";
      } else if (character == "r") {
        output += "\r";
      } else if (character == "t") {
        output += "\t";
      } else if (character == "\"" || character == "\\") {
        output += character;
      } else {
        return fail(fmt.Errorf("line %d: unsupported escape sequence \\%s", lineNumber, character));
      }
      escaped = false;
    } else if (character == "\\") {
      escaped = true;
    } else if (character == "\"") {
      validateTrailing(value[index + 1:], lineNumber)?;
      return ok(output);
    } else {
      output += character;
    }
  }
  return fail(fmt.Errorf("line %d: unterminated double-quoted value", lineNumber));
}

function validateTrailing(source: bstring, lineNumber: int): Result<void> {
  const trailing = strings.TrimSpace(source);
  if (trailing != "" && !strings.HasPrefix(trailing, "#")) {
    return fail(fmt.Errorf("line %d: unexpected text after quoted value", lineNumber));
  }
  return ok();
}
