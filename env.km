import go fmt from "fmt";
import go os from "os";
import go strconv from "strconv";
import go strings from "strings";

export class Environment {
  private values: Map<string, string>;

  constructor() {
    this.values = makeMap[string, string]();
  }

  public function has(name: string): boolean {
    const [_, found] = this.values[name];
    return found;
  }

  public function text(name: string): Result<string> {
    const [value, found] = this.values[name];
    if (!found) {
      return fail(fmt.Errorf("environment variable %s is not defined", name));
    }
    return ok(value);
  }

  public function textOr(name: string, defaultValue: string): string {
    const [value, found] = this.values[name];
    if (!found) {
      return defaultValue;
    }
    return value;
  }

  public function integer(name: string): Result<int> {
    const value = this.text(name)?;
    const [parsed, parseError] = strconv.Atoi(value);
    if (parseError !== nil) {
      return fail(fmt.Errorf("environment variable %s has invalid integer value %q", name, value));
    }
    return ok(parsed);
  }

  public function integerOr(name: string, defaultValue: int): Result<int> {
    if (!this.has(name)) {
      return ok(defaultValue);
    }
    return this.integer(name);
  }

  public function boolean(name: string): Result<boolean> {
    const value = this.text(name)?;
    const [parsed, parseError] = strconv.ParseBool(value);
    if (parseError !== nil) {
      return fail(fmt.Errorf("environment variable %s has invalid boolean value %q", name, value));
    }
    return ok(parsed);
  }

  public function booleanOr(name: string, defaultValue: boolean): Result<boolean> {
    if (!this.has(name)) {
      return ok(defaultValue);
    }
    return this.boolean(name);
  }

  public function set(name: string, value: string): Result<void> {
    if (!validName(name)) {
      return fail(fmt.Errorf("invalid environment variable name %q", name));
    }
    this.values[name] = value;
    return ok();
  }

  public function apply(overwrite: boolean): Result<void> {
    for (const [name, value] of this.values) {
      const [_, exists] = os.LookupEnv(name);
      if (overwrite || !exists) {
        os.Setenv(name, value)?;
      }
    }
    return ok();
  }
}

export function parse(text: string): Result<Environment> {
  const environment = new Environment();
  const lines = strings.Split(strings.TrimPrefix(text, "\uFEFF"), "\n");

  for (let index = 0; index < len(lines); index++) {
    const lineNumber = index + 1;
    let line = strings.TrimSuffix(lines[index], "\r");
    line = strings.TrimSpace(line);
    if (line == "" || strings.HasPrefix(line, "#")) {
      continue;
    }
    if (strings.HasPrefix(line, "export ") || strings.HasPrefix(line, "export\t")) {
      line = strings.TrimSpace(line[6:]);
    }

    const separator = strings.Index(line, "=");
    if (separator < 0) {
      return fail(fmt.Errorf("line %d: expected NAME=VALUE", lineNumber));
    }
    const name = strings.TrimSpace(line[:separator]);
    const value = parseValue(line[separator + 1:], lineNumber)?;
    const [setError] = environment.set(name, value);
    if (setError !== nil) {
      return fail(fmt.Errorf("line %d: %s", lineNumber, setError.Error()));
    }
  }
  return ok(environment);
}

export function load(path: string): Result<Environment> {
  const contents = os.ReadFile(path)?;
  return parse(string(contents));
}

export function fromProcess(names: string[]): Result<Environment> {
  const environment = new Environment();
  for (const name of names) {
    if (!validName(name)) {
      return fail(fmt.Errorf("invalid environment variable name %q", name));
    }
    const [value, found] = os.LookupEnv(name);
    if (found) {
      const _ = environment.set(name, value);
    }
  }
  return ok(environment);
}

function validName(name: string): boolean {
  if (len(name) == 0) {
    return false;
  }
  for (let index = 0; index < len(name); index++) {
    const character = name[index:index + 1];
    const letter = (character >= "a" && character <= "z") || (character >= "A" && character <= "Z");
    const digit = character >= "0" && character <= "9";
    if (index == 0) {
      if (!letter && character != "_") {
        return false;
      }
    } else if (!letter && !digit && character != "_") {
      return false;
    }
  }
  return true;
}

function parseValue(source: string, lineNumber: int): Result<string> {
  const value = strings.TrimSpace(source);
  if (value == "") {
    return ok("");
  }
  if (strings.HasPrefix(value, "'")) {
    return parseSingleQuoted(value, lineNumber);
  }
  if (strings.HasPrefix(value, "\"")) {
    return parseDoubleQuoted(value, lineNumber);
  }

  for (let index = 0; index < len(value); index++) {
    if (value[index:index + 1] == "#" && index > 0) {
      const previous = value[index - 1:index];
      if (previous == " " || previous == "\t") {
        return ok(strings.TrimSpace(value[:index]));
      }
    }
  }
  return ok(value);
}

function parseSingleQuoted(value: string, lineNumber: int): Result<string> {
  const closing = strings.Index(value[1:], "'");
  if (closing < 0) {
    return fail(fmt.Errorf("line %d: unterminated single-quoted value", lineNumber));
  }
  const end = closing + 1;
  validateTrailing(value[end + 1:], lineNumber)?;
  return ok(value[1:end]);
}

function parseDoubleQuoted(value: string, lineNumber: int): Result<string> {
  let output = "";
  let escaped = false;
  for (let index = 1; index < len(value); index++) {
    const character = value[index:index + 1];
    if (escaped) {
      if (character == "n") {
        output += "\n";
      } else if (character == "r") {
        output += "\r";
      } else if (character == "t") {
        output += "\t";
      } else if (character == "\"" || character == "\\") {
        output += character;
      } else {
        return fail(fmt.Errorf("line %d: unsupported escape sequence \\%s", lineNumber, character));
      }
      escaped = false;
    } else if (character == "\\") {
      escaped = true;
    } else if (character == "\"") {
      validateTrailing(value[index + 1:], lineNumber)?;
      return ok(output);
    } else {
      output += character;
    }
  }
  return fail(fmt.Errorf("line %d: unterminated double-quoted value", lineNumber));
}

function validateTrailing(source: string, lineNumber: int): Result<void> {
  const trailing = strings.TrimSpace(source);
  if (trailing != "" && !strings.HasPrefix(trailing, "#")) {
    return fail(fmt.Errorf("line %d: unexpected text after quoted value", lineNumber));
  }
  return ok();
}
